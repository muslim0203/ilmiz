[Unit]
Description=IlmIz sayt statistikasi (GoAccess hisoboti)
Documentation=https://github.com/muslim0203/ilmiz
ConditionPathExists=/var/log/nginx/access.log

[Service]
Type=oneshot
User=ilmiz
Group=ilmiz
# nginx loglari `root:adm 0640` — o'qish uchun shu guruh kerak.
SupplementaryGroups=adm
WorkingDirectory=/opt/ilmiz/app
Environment=ILMIZ_STATS_DIR=/var/lib/ilmiz/stats
ExecStart=/usr/bin/env bash deploy/generate_stats.sh
TimeoutStartSec=15min
Nice=15
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Loglar faqat o'qiladi, yoziladigan yagona joy — hisobot katalogi.
ReadWritePaths=/var/lib/ilmiz/stats
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
