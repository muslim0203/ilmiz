# IlmIz — ishlab chiqarish muhiti. `/etc/ilmiz/production.env` ga nusxalanadi.
#
# Diqqat: bu namuna fayl. Haqiqiy sirlar (admin tokeni, OAuth kalitlari)
# faqat serverdagi nusxaga yoziladi va repoga tushmaydi.

DATABASE_URL=sqlite:////var/lib/ilmiz/ilmiz.db

# Kanonik domen. `https://` shart: `seo.is_production_host()` faqat
# HTTPS'da indekslashga ruxsat beradi, ya'ni sertifikat o'rnatilmaguncha
# sayt qidiruv tizimlariga ochilmaydi.
ILMIZ_SITE_URL=https://ilmiz.uz
ILMIZ_PUBLIC_URL=https://ilmiz.uz

# Staging'da 1 edi. Prodda o'chirilgan — aks holda sayt indekslanmaydi.
ILMIZ_NOINDEX=0

ILMIZ_DIST_DIR=/opt/ilmiz/app/dist
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# --- To'ldirilishi kerak ---------------------------------------------------

# Admin panel uchun. Uzun tasodifiy qiymat:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ILMIZ_ADMIN_TOKEN=

# OAuth. Konsollarda ruxsat etilgan qaytish manzili aynan shunday
# ko'rsatilishi kerak:
#   https://ilmiz.uz/api/auth/orcid/callback
#   https://ilmiz.uz/api/auth/google/callback
# ORCID_CLIENT_ID=
# ORCID_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Yangi sahifalar haqida qidiruv tizimlariga xabar berish uchun (ixtiyoriy).
# ILMIZ_INDEXNOW_KEY=
