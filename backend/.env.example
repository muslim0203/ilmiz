# Local fallback (default)
DATABASE_URL=sqlite:///./ilmiz.db

# Production PostgreSQL example
# DATABASE_URL=postgresql+psycopg://ilmiz:change-me@127.0.0.1:5432/ilmiz

API_HOST=127.0.0.1
API_PORT=8000

# Admin API tokeni. Sozlanmagan bo'lsa /api/admin/* butunlay yopiq (503).
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(32))"
ILMIZ_ADMIN_TOKEN=change-me

# --- Foydalanuvchi autentifikatsiyasi ---
# Public URL: OAuth callback manzili shundan quriladi.
ILMIZ_PUBLIC_URL=http://localhost:5173

# ORCID: https://orcid.org/developer-tools da ro'yxatdan o'tkaziladi.
# Redirect URI: <ILMIZ_PUBLIC_URL>/api/auth/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Sinov uchun: ORCID_BASE_URL=https://sandbox.orcid.org

# Google: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
# Redirect URI: <ILMIZ_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
